rules_version = '2';

function isSignedIn() {
  return request.auth != null;
}

function role() {
  return isSignedIn() && exists(/databases/(default)/documents/users/$(request.auth.uid))
    ? get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
    : null;
}

function isAdmin() {
  return role() == "admin";
}

function isStaff() {
  return role() == "admin" || role() == "teacher";
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/studentAccess {
      allow read, write: if isStaff();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isStaff();

      match /tests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /readingTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /dictationTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /comprehensionTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /practiceTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /listeningTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /speechLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false;
    }

    match /speakingSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if true;
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create: if true;
        allow update, delete: if false;
      }
    }

    match /attempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isStaff();
    }

    match /classAssignments/{className} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
