rules_version = '2';

function isSignedIn() {
  return request.auth != null;
}

// Tài khoản bị khoá (disabled) coi như không có vai trò — mất mọi quyền theo vai trò (2026-09-26).
function role() {
  return isSignedIn() && exists(/databases/(default)/documents/users/$(request.auth.uid))
      && get(/databases/(default)/documents/users/$(request.auth.uid)).data.get('disabled', false) != true
    ? get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
    : null;
}

function isAdmin() {
  return role() == "admin";
}

function isStaff() {
  return role() == "admin" || role() == "teacher";
}

// Giáo viên dạy ngắn hạn/vài lớp (chốt 2026-09-22): VẪN là role "teacher" bình thường, chỉ thêm
// field `restricted` trên hồ sơ để giới hạn phạm vi — KHÔNG có field này (hoặc = false) thì hoạt
// động y hệt giáo viên full-time hiện tại (không phá tài khoản giáo viên cũ). Khi restricted=true:
// `allowedSeriesIds` giới hạn "Tạo bài" theo bộ đề, `allowedClasses` giới hạn "Mở bài" theo lớp.
function myProfile() {
  return isSignedIn() && exists(/databases/(default)/documents/users/$(request.auth.uid))
    ? get(/databases/(default)/documents/users/$(request.auth.uid)).data
    : null;
}

// Dùng .get(field, mặc định): hồ sơ giáo viên cũ KHÔNG có field restricted/allowed... — truy cập thẳng field
// không tồn tại làm rules báo lỗi → bị từ chối quyền (lỗi thật 2026-09-25 khi xoá học sinh).
function isRestrictedTeacher() {
  return role() == "teacher" && myProfile() != null && myProfile().get('restricted', false) == true;
}

// Admin + giáo viên chính (không bị giới hạn) — được tạo/sửa/xoá tài khoản học sinh và lớp (chốt 2026-09-25).
function isFullStaff() {
  return isAdmin() || (role() == "teacher" && !isRestrictedTeacher());
}

function canManageSeries(seriesId) {
  return isAdmin()
    || (role() == "teacher" && (!isRestrictedTeacher()
      || seriesId in myProfile().get('allowedSeriesIds', [])));
}

function canManageClass(className) {
  return isAdmin()
    || (role() == "teacher" && (!isRestrictedTeacher()
      || className in myProfile().get('allowedClasses', [])));
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/studentAccess {
      allow read, write: if isStaff();
    }

    match /users/{uid} {
      // Chỉ admin/giáo viên đọc hồ sơ người khác; học sinh/tester chỉ đọc hồ sơ của chính mình (2026-09-25 —
      // trước đó mọi tài khoản đăng nhập đọc được tên/lớp/tên đăng nhập của toàn bộ học sinh).
      allow read: if isStaff() || (isSignedIn() && request.auth.uid == uid);
      allow write: if isAdmin();
      // Admin + giáo viên chính được tạo hồ sơ HỌC SINH (Dashboard → Tài khoản học sinh), không được tạo
      // admin/teacher. Giáo viên phụ (restricted) chỉ xem, không thêm/sửa/xoá học sinh (chốt 2026-09-25).
      allow create: if isFullStaff() && request.resource.data.role == 'student';
      // Giáo viên chính tạo tài khoản GIÁO VIÊN PHỤ (bắt buộc restricted = true, chỉ đúng các field này) — 2026-09-26.
      allow create: if isFullStaff() && request.resource.data.role == 'teacher'
        && request.resource.data.get('restricted', false) == true
        && request.resource.data.keys().hasOnly(['role', 'email', 'username', 'mustChangePassword', 'restricted', 'allowedSeriesIds', 'allowedClasses', 'createdAt']);
      // ... và khoá/mở khoá/chuyển lớp/xoá hồ sơ học sinh (chỉ đụng tới tài khoản role student).
      // Không được đổi role (chặn nâng tài khoản học sinh thành admin/teacher rồi đăng nhập bằng nó, 2026-09-25).
      allow update: if isFullStaff() && resource.data.role == 'student' && request.resource.data.role == 'student';
      allow delete: if isFullStaff() && resource.data.role == 'student';
      // Học sinh tự xoá cờ "phải đổi mật khẩu lần đầu" trên hồ sơ của chính mình (chỉ đúng field này).
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']);
      // Bất kỳ staff nào (admin hoặc giáo viên) sửa PHẠM VI của 1 tài khoản GIÁO VIÊN khác — để
      // giáo viên chính tự phân công người dạy ngắn hạn mà không cần đợi admin mỗi lần (chốt
      // 2026-09-22). Chỉ được đụng đúng 3 field này, không đổi email/role/mật khẩu. Giáo viên KHÔNG
      // tự sửa phạm vi của chính mình, và giáo viên bị giới hạn không sửa được của ai (2026-09-24).
      allow update: if isStaff() && resource.data.role == 'teacher' && request.resource.data.role == 'teacher'
        && (isAdmin() || (!isRestrictedTeacher() && request.auth.uid != uid))
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['restricted', 'allowedSeriesIds', 'allowedClasses']);
      // Khoá/mở khoá giáo viên (2026-09-26): admin khoá được mọi giáo viên khác; giáo viên chính chỉ khoá giáo viên phụ.
      allow update: if isFullStaff() && request.auth.uid != uid
        && resource.data.role == 'teacher' && request.resource.data.role == 'teacher'
        && (isAdmin() || resource.data.get('restricted', false) == true)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['disabled']);
    }

    // Nội dung bài (có cả đáp án) chỉ tài khoản đã đăng nhập đọc được (audit bảo mật 2026-09-25 — trước đó ai biết
    // API key công khai cũng đọc thẳng được đáp án qua Firestore REST). Mọi trang bài học đều đã bắt đăng nhập.
    match /lessons/{lessonId} {
      allow read: if isSignedIn();
      // Doc lesson gốc luôn có field seriesId (xem lib/adminLessons.js) — dùng thẳng để biết bộ đề.
      allow create, update: if canManageSeries(request.resource.data.seriesId);
      allow delete: if canManageSeries(resource.data.seriesId);

      // Các subcollection bên dưới KHÔNG tự lưu seriesId (chỉ lưu ở doc lesson cha) — lấy seriesId
      // của doc cha qua get() để biết giáo viên có được thao tác bộ đề này không.
      match /tests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /readingTests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /dictationTests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /comprehensionTests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /practiceTests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /listeningExamTests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /listeningTests/{testId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }

      match /vocabularyUnits/{unitId} {
        allow read: if isSignedIn();
        allow write: if canManageSeries(get(/databases/(default)/documents/lessons/$(lessonId)).data.seriesId);
      }
    }

    // Ghi phải đăng nhập + đúng uid của chính mình; chỉ admin/giáo viên đọc (audit bảo mật 2026-09-25 — trước đó
    // ai cũng ghi được kể cả chưa đăng nhập, và mọi tài khoản đọc được log/phiên của học sinh khác).
    match /speechLogs/{logId} {
      allow read: if isStaff();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      allow update, delete: if false;
    }

    // Admin/giáo viên xoá được (tự dọn kết quả quá 48h sau hạn chót — lib/testResults.js purgeExpiredResults).
    match /speakingSessions/{sessionId} {
      allow read: if isStaff();
      allow create: if isSignedIn() && request.resource.data.uid == request.auth.uid;
      // Học sinh chỉ cập nhật mốc thời gian trên phiên của chính mình (lib/speakingSessions.js).
      allow update: if isSignedIn() && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['updatedAt', 'finishedAt']);
      allow delete: if isStaff();

      match /events/{eventId} {
        allow read: if isStaff();
        allow create: if isSignedIn()
          && get(/databases/(default)/documents/speakingSessions/$(sessionId)).data.uid == request.auth.uid;
        allow update: if false;
        allow delete: if isStaff();
      }
    }

    // Id doc = "<uid>_<mode>_<testId>" (lib/attempts.js) — học sinh chỉ đọc lượt của chính mình; kiểm tra theo id
    // vì doc chưa tồn tại (lần làm đầu tiên) thì không có resource.data để so uid.
    // Nộp bài qua máy chủ (chốt 2026-09-25, worker/src/submit.js): Worker (service account, bỏ qua rules) kiểm tra
    // lớp/hạn chót/số lượt/thời gian, tự chấm rồi ghi kết quả + cộng lượt. Trình duyệt KHÔNG được tự ghi 2 collection
    // dưới đây nữa (trước đó học sinh có thể gửi điểm tự bịa hoặc không cộng lượt).
    // Id doc = "<uid>_<mode>_<testId>" — học sinh chỉ đọc lượt của chính mình; kiểm tra theo id vì doc chưa tồn tại
    // (lần làm đầu tiên) thì không có resource.data để so uid.
    match /attempts/{attemptId} {
      allow read: if isStaff() || (isSignedIn() && attemptId.matches(request.auth.uid + '_.*'));
      allow create, update: if false;
      allow delete: if isStaff();
    }

    // Kết quả chi tiết từng câu (mọi dạng bài) — chỉ Worker ghi, chỉ giáo viên/admin đọc. Admin/giáo viên xoá được:
    // kết quả chỉ giữ tới 48h sau hạn chót lần mở bài rồi bị xoá hẳn (lib/testResults.js, chốt 2026-09-25).
    match /testResults/{resultId} {
      allow read: if isStaff();
      allow create, update: if false;
      allow delete: if isStaff();
    }

    // Mốc giờ bắt đầu làm bài (Worker ghi/đọc để tính thời gian làm bài theo giờ máy chủ) — trình duyệt không đụng tới.
    match /testStarts/{startId} {
      allow read, write: if false;
    }

    // Đáp án tách khỏi đề (lib/grading/answerKeys.js, 2026-09-25): học sinh KHÔNG đọc được; admin/giáo viên/tài khoản
    // đặc biệt đọc để soạn bài/xem đáp án; Worker đọc để chấm. Ghi theo quyền soạn bộ đề (cùng quyền với đề bài).
    match /answerKeys/{keyId} {
      allow read: if isStaff() || role() == "tester";
      allow create, update: if canManageSeries(request.resource.data.seriesId);
      allow delete: if canManageSeries(resource.data.seriesId);
    }

    // "Mở bài" cho lớp (lib/openings.js): học sinh đăng nhập đọc để biết bài nào đang mở cho lớp mình, chỉ
    // admin/teacher tạo/sửa/đóng. Không còn mật khẩu vào bài (bỏ 2026-09-25).
    match /openings/{openingId} {
      allow read: if isSignedIn();
      allow create, update: if canManageClass(request.resource.data.className);
      allow delete: if canManageClass(resource.data.className);
    }

    // Lớp học (lib/classes.js, chốt 2026-09-25): id doc = tên lớp. Tạo lớp trước rồi mới thêm học sinh vào lớp.
    // Chỉ admin + giáo viên chính tạo/xoá lớp.
    match /classes/{classId} {
      allow read: if isSignedIn();
      allow create, update, delete: if isFullStaff();
    }

    // Sách online (Kids) — xem lib/adminLessons.js listKidsBooks/saveKidsBook. Không theo cấu trúc
    // Level/Test nên không có seriesId để canManageSeries() lọc — giáo viên bị giới hạn bộ đề vẫn
    // soạn được sách Kids (chốt 2026-09-23, mục này chưa nằm trong phạm vi allowedSeriesIds).
    match /kidsBooks/{bookId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
