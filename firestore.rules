rules_version = '2';

function isSignedIn() {
  return request.auth != null;
}

function role() {
  return isSignedIn() && exists(/databases/(default)/documents/users/$(request.auth.uid))
    ? get(/databases/(default)/documents/users/$(request.auth.uid)).data.role
    : null;
}

function isAdmin() {
  return role() == "admin";
}

function isStaff() {
  return role() == "admin" || role() == "teacher";
}

service cloud.firestore {
  match /databases/{database}/documents {

    match /settings/studentAccess {
      allow read, write: if isStaff();
    }

    // Hash mật khẩu theo TỪNG BỘ ĐỀ (Starters/Movers/Flyers/...) — thay tài khoản học sinh (chốt
    // 2026-09-17, xem lib/seriesAccess.js). Đọc công khai (học sinh chưa đăng nhập cần so khớp
    // ngay trên trình duyệt), chỉ admin/teacher ghi được.
    match /settings/seriesPasswords {
      allow read: if true;
      allow write: if isStaff();
    }

    match /users/{uid} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
      // Giáo viên được tạo hồ sơ HỌC SINH (Dashboard → Tài khoản học sinh), không được tạo admin/teacher.
      allow create: if isStaff() && request.resource.data.role == 'student';
      // Học sinh tự xoá cờ "phải đổi mật khẩu lần đầu" trên hồ sơ của chính mình (chỉ đúng field này).
      allow update: if isSignedIn() && request.auth.uid == uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mustChangePassword']);
    }

    match /lessons/{lessonId} {
      allow read: if true;
      allow write: if isStaff();

      match /tests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /readingTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /dictationTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /comprehensionTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /practiceTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /listeningExamTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /listeningTests/{testId} {
        allow read: if true;
        allow write: if isStaff();
      }

      match /vocabularyUnits/{unitId} {
        allow read: if true;
        allow write: if isStaff();
      }
    }

    match /speechLogs/{logId} {
      allow read: if isSignedIn();
      allow create: if true;
      allow update, delete: if false;
    }

    match /speakingSessions/{sessionId} {
      allow read: if isSignedIn();
      allow create, update: if true;
      allow delete: if false;

      match /events/{eventId} {
        allow read: if isSignedIn();
        allow create: if true;
        allow update, delete: if false;
      }
    }

    match /attempts/{attemptId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == 1;
      allow update: if isSignedIn()
        && resource.data.uid == request.auth.uid
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.count == resource.data.count + 1;
      allow delete: if isStaff();
    }

    // Kết quả chi tiết từng câu (mọi dạng bài) — học sinh chỉ ghi, chỉ giáo viên/admin đọc.
    match /testResults/{resultId} {
      allow read: if isStaff();
      allow create: if true;
      allow update, delete: if false;
    }

    // "Mở bài" cho lớp (lib/openings.js): học sinh đăng nhập đọc để biết bài nào đang mở cho lớp mình, chỉ
    // admin/teacher tạo/sửa/đóng. Mật khẩu vào bài lưu dạng hash SHA-256.
    match /openings/{openingId} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /classAssignments/{className} {
      allow read: if isSignedIn();
      allow write: if isStaff();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
